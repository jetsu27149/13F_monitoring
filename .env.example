# Copy to .env and fill in. .env is git-ignored.
# Every key below is optional; the dashboard runs without them, with the
# corresponding panel disabled.

# SEC asks automated clients to identify themselves. Use your own contact email.
SEC_USER_AGENT="13F Monitoring local dashboard your-email@example.com"

# Financial Modeling Prep: analyst ratings, price-target consensus, past earnings.
FMP_API_KEY=

# Finnhub: recommendation trends and price targets, used as a fallback for FMP.
FINNHUB_API_KEY=

# OpenAI: direct model answers in the Filing Q&A box. Without it the app still
# assembles local SEC filing context for you to paste elsewhere.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
